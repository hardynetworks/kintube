# --- Required ---
# The domain family members visit (DNS A record -> this server)
DOMAIN=kincast.example.com

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-64-random-hex-chars
RTMP_CALLBACK_SECRET=change-me-too

# --- Optional ---
# Hostname OBS connects to. Must be a DNS-only (grey cloud) record if you use Cloudflare,
# because Cloudflare's proxy does not carry RTMP. Defaults to DOMAIN.
# RTMP_HOST=live.kincast.example.com

# Image tag to run (latest, a version like 1.0.0, or sha-abc1234)
# KINTUBE_TAG=latest

# Change only if 172.30.77.0/24 collides with an existing network on the server
# KINTUBE_SUBNET=172.30.77.0/24
# APP_IP=172.30.77.10

# Change if 80/443 are already used on the server (e.g. by another reverse proxy)
# HTTP_PORT=80
# HTTPS_PORT=443

# Max size of a single uploaded video, in GB
MAX_UPLOAD_GB=20
# Quality ladder for uploads (short-side pixels). Fewer = faster processing, less disk.
TRANSCODE_RENDITIONS=1080,720,360
# x264 speed/quality tradeoff: ultrafast, superfast, veryfast, faster, fast, medium
X264_PRESET=veryfast
# Keep the original file so family can download it (uses extra disk)
KEEP_ORIGINALS=true
